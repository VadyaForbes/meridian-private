# Public canonical origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional HubSpot channel. Leave empty to queue CRM delivery until configured.
HUBSPOT_ACCESS_TOKEN=

# Optional Resend channel. Configure all three values together.
# Email delivery remains queued until the complete channel is configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meridian Private <briefs@example.com>
LEAD_NOTIFICATION_EMAIL=

# Durable retry queue and distributed rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LEAD_ENCRYPTION_KEY=

# Protects the retry endpoint used by Vercel Cron
CRON_SECRET=

# Optional analytics provider identifiers
NEXT_PUBLIC_GA_MEASUREMENT_ID=
