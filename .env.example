# Public canonical origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# HubSpot private app token and optional pipeline owner
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_OWNER_ID=

# Resend API key and verified sender
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meridian Private <briefs@example.com>
LEAD_NOTIFICATION_EMAIL=

# Durable retry queue and distributed rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LEAD_ENCRYPTION_KEY=

# Protects the retry endpoint used by Vercel Cron
CRON_SECRET=

# Optional analytics provider identifiers
NEXT_PUBLIC_GA_MEASUREMENT_ID=
